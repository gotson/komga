{
  "name": "next-ui",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode prod",
    "build:mode-dev": "vite build --mode development",
    "build:with-i18n": "run-s i18n:compile \"build {@}\" --",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:unit:coverage": "vitest run --project unit --coverage",
    "test:unit:watch": "vitest watch --project unit",
    "test:storybook": "vitest run --project storybook",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "prettier --check \"**/*.{js,ts,vue,scss,html,md,json}\"",
    "prettier:fix": "npm run prettier -- --write",
    "openapi-ts": "openapi-ts",
    "i18n:clean-empty": "tsx i18n-clean-empty.config.ts",
    "i18n:compile": "run-s formatjs:compile i18n:clean-empty",
    "formatjs:extract": "formatjs extract \"src/**/*.{ts,tsx,vue}\" --ignore=\"**/*.d.ts\" --ignore=\"**/*.stories.*\" --out-file i18n/en.json",
    "formatjs:compile": "formatjs compile-folder i18n src/i18n",
    "formatjs:verify": "formatjs verify --missing-keys --source-locale=en \"i18n/*.json\"",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "chromatic": "chromatic",
    "chromatic:force-rebuild": "chromatic --force-rebuild"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.9.0",
    "@logtape/logtape": "^2.3.5",
    "@logtape/pretty": "^2.3.0",
    "@pinia/colada": "^1.4.4",
    "@pinia/colada-plugin-auto-refetch": "^0.2.6",
    "@pinia/colada-plugin-delay": "^0.2.1",
    "@unhead/vue": "^3.4.1",
    "@vueuse/components": "^14.4.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/router": "^14.4.0",
    "core-js": "^3.50.0",
    "filesize": "^11.0.24",
    "marked": "^18.0.13",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "^6.16.0",
    "valibot": "^1.5.0",
    "validator": "^13.15.35",
    "vue": "^3.5.42",
    "vue-clamp": "^1.7.1",
    "vue-draggable-plus": "^0.6.1",
    "vue-intl": "^7.2.15",
    "vuetify": "^4.2.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "^6.16.29",
    "@hey-api/openapi-ts": "0.99.0",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.38",
    "@pinia/colada-devtools": "^1.1.2",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.1.2",
    "@types/qs": "^6.15.1",
    "@types/validator": "^13.15.10",
    "@unocss/preset-icons": "^66.10.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "chromatic": "^18.9.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-formatjs": "^6.4.20",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.14.5",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "npm-run-all2": "^9.0.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "sass": "^1.104.1",
    "sass-embedded": "^1.104.1",
    "storybook": "^10.6.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "unocss": "^66.10.4",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-fonts": "^2.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vite-plugin-dir2json": "^1.3.0",
    "vite-plugin-vue-layouts-next": "^2.1.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.11",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  },
  "msw": {
    "workerDirectory": [
      "public-msw"
    ]
  }
}
